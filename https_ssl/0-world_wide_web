#!/usr/bin/env bash
# Displays the record type and destination of a domain's subdomains
# shellcheck disable=SC2086

audit_subdomain() {
    local domain=$1
    local subdomain=$2
    dig "$subdomain.$domain" | awk -v s="$subdomain" '/ANSWER SECTION:/ {
        getline
        print "The subdomain " s " is a " $4 " record and points to " $5
    }'
}

if [ $# -eq 1 ]; then
    for sub in www lb-01 web-01 web-02; do
        audit_subdomain $1 $sub
    done
elif [ $# -eq 2 ]; then
    audit_subdomain $1 $2
fi
